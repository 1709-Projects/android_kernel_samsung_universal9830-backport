# Unified config for Exynos 990 devices
#
# Union of the per-device fragments: x1s, x1slte, y2s, y2slte, z3s,
# c1s, c1slte, c2s, c2slte and r8s.  Use after exynos9830_defconfig:
#
#   make exynos9830_defconfig unified.config
#
# The bootloader still selects the matching DTBO from the device's dtbo
# partition; the kernel Image itself is shared by all supported models.

CONFIG_MODEL_X1S=y
CONFIG_MODEL_X1SLTE=y
CONFIG_MODEL_Y2S=y
CONFIG_CAMERA_HST_V02=y
CONFIG_CAMERA_CIS_TOF_BUCK_USE=y
CONFIG_CAMERA_CIS_IMX516_OBJ=y
CONFIG_CAMERA_CIS_IMX518_OBJ=y
CONFIG_MODEL_Y2SLTE=y
CONFIG_MODEL_Z3S=y
CONFIG_CAMERA_HST_V03=y
CONFIG_CAMERA_CIS_GH1_OBJ=y
CONFIG_CAMERA_CIS_2L3_OBJ=y
CONFIG_CAMERA_CIS_HM1_OBJ=y
CONFIG_CAMERA_CIS_IMX586_OBJ=y
CONFIG_WIRELESS_CHARGER_MFC_S2MIW04=y
CONFIG_WIRELESS_CHARGER_HAL_MFC=y
CONFIG_SENSORS_A96T3X6=y
CONFIG_SENSORS_FW_VENDOR=y
CONFIG_SENSORS_A96T365IF=y
CONFIG_SENSORS_A96T3X6_CRC_CHECK=y
CONFIG_SENSORS_A96T3X6_BLOCK_SAR_ONLY=y
CONFIG_MODEL_C1S=y
CONFIG_NFC_PN547=y
CONFIG_NFC_FEATURE_SN100U=y
CONFIG_NFC_PN547_ESE_SUPPORT=y
# CONFIG_TOUCHSCREEN_SEC_TS_Y79A is not set
CONFIG_TOUCHSCREEN_SEC_TS_Y79A_C=y
CONFIG_INPUT_WACOM=y
CONFIG_EPEN_WACOM_W9020=y
CONFIG_CAMERA_CNT_V01=y
CONFIG_USE_OIS_TAMODE_CONTROL=y
CONFIG_SUPPORT_GM2_FLASH=y
CONFIG_SUPPORT_FAST_DISCHARGE=y
CONFIG_EXYNOS_DECON_LCD_S6E3FA9=y
CONFIG_EXYNOS_DECON_LCD_S6E3FAB=y
CONFIG_EXYNOS_DECON_LCD_S6E3HAB=y
# CONFIG_SENSORS_SSP_LSM6DSO is not set
# CONFIG_SENSORS_SSP_MAGNETIC_COMMON is not set
# CONFIG_SENSORS_SSP_TMD4907 is not set
# CONFIG_SENSORS_SSP_LPS22H is not set
# CONFIG_SENSORS_SSP_PROX_AUTOCAL_AMS is not set
CONFIG_SENSORS_DYNAMIC_SENSORLIST=y
CONFIG_SENSORS_ICM42632M=y
CONFIG_SENSORS_LSM6DSO=y
CONFIG_SENSORS_TMD4907=y
CONFIG_SENSORS_STK31610=y
CONFIG_SENSORS_AK09918C=y
CONFIG_SENSORS_LPS22H=y
CONFIG_SENSORS_LPS25H=y
CONFIG_SENSORS_SSP_CANVAS=y
CONFIG_MOTOR_DRV_MAX77705=y
CONFIG_SEC_HAPTIC=y
CONFIG_WLAN_BCM4375_ADVANCED_FEATURES=y
CONFIG_SEC_NAD_API=y
CONFIG_NAD_55=y
CONFIG_SEC_NAD_PMIC=y
CONFIG_SEC_SUPPORT_MOTTOTEST_WITH_ACT=y
CONFIG_SEC_BPS_INFO_ADD=y
CONFIG_MODEL_C1SLTE=y
CONFIG_MODEL_C2S=y
CONFIG_CAMERA_CNT_V02=y
CONFIG_CAMERA_CIS_3M5_OBJ=y
CONFIG_CAMERA_LASER_AF_VL53L5_OBJ=y
CONFIG_EXYNOS_DECON_LCD_S6E3HAC=y
CONFIG_SUPPORT_ERRFG_RECOVERY=y
CONFIG_DECON_VRR_MODULATION=y
CONFIG_SENSORS_VL53L5=y
CONFIG_SENSORS_VL53L5_C2=y
CONFIG_SENSORS_VL53L5_SUPPORT_UAPI=y
CONFIG_SENSORS_VL53L5_SUPPORT_KERNEL_INTERFACE=y
CONFIG_MODEL_C2SLTE=y
CONFIG_MODEL_R8S=y
CONFIG_MHI_BUS=y
CONFIG_MHI_DEBUG=y
CONFIG_MHI_UCI=y
CONFIG_QRTR=y
CONFIG_QRTR_MHI=y
CONFIG_QCA_CLD_WLAN=y
CONFIG_MSM_BT_POWER=y
CONFIG_WIRELESS_EXT=y
CONFIG_WEXT_PRIV=y
CONFIG_CNSS2=y
CONFIG_CNSS2_QMI=y
CONFIG_CNSS_QCA6390=y
CONFIG_CNSS_GENL=y
CONFIG_WCNSS_MEM_PRE_ALLOC=y
CONFIG_BUS_AUTO_SUSPEND=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_TOUCHSCREEN_ZINITIX_ZT7650=y
CONFIG_TOUCHSCREEN_STM_FTS5CU56A=y
CONFIG_CAMERA_RST_V08=y
CONFIG_CAMERA_CIS_IMX616_OBJ=y
CONFIG_CAMERA_CIS_HI847_OBJ=y
CONFIG_CAMERA_CIS_3L6_OBJ=y
CONFIG_CAMERA_FLASH_RT8547_OBJ=y
CONFIG_EXYNOS_DOZE_FIRST_FRAME_BLACK=y
CONFIG_SUPPORT_MASK_LAYER=y
CONFIG_PANEL_DECON_BOARD=y
CONFIG_PANEL_MAGNA_DDI=y
CONFIG_EXYNOS_DECON_LCD_EA8076=y
CONFIG_EXYNOS_DECON_LCD_EA8079=y
CONFIG_EXYNOS_DECON_LCD_S6E3FC3=y
CONFIG_TX_5V_DISABLE=y
CONFIG_SENSORS_SSP_R8=y
CONFIG_SENSORS_SABC=y
CONFIG_SENSORS_GW9558X=y
CONFIG_LEDS_RT8547=y
CONFIG_LOCALVERSION="-u9830"

# Keep app workingsets when the userspace app compactor requests
# RECLAIM_ALL; otherwise the kernel reclaims them under running apps.
CONFIG_PROCESS_RECLAIM_IGNORE_ALL_TYPE=y

# CONFIG_LOCALVERSION_AUTO is not set
